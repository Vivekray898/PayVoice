    <!-- Why it matters, one plain sentence each -->
    <string name="health_notifications_why">PayVoice needs notifications to keep announcements reliable while your screen is off.</string>
    <string name="health_channel_why">Turn the Payment events channel back on so alerts aren\'t downgraded to silent.</string>
    <string name="health_dnd_why">While Do Not Disturb is on, payment announcements are held back.</string>
    <string name="health_battery_why">Allow unrestricted battery use so a payment is never announced late.</string>
    <string name="health_autostart_why">Allow PayVoice to start on its own so announcements keep arriving.</string>
    <string name="health_listener_why">Grant access so PayVoice can hear Google Pay telling you that a customer paid.</string>
    <string name="health_tts_why">Install a text-to-speech voice so PayVoice can speak the amount out loud.</string>
    <string name="health_voice_why">Download the voice for your chosen language, or switch to one you already have.</string>
    <string name="health_volume_why">Turn the volume up so you can hear the announcement.</string>
    <string name="health_internet_why">PayVoice needs a connection to reach your business and receive remote alerts.</string>
    <string name="health_fcm_why">Alerts from your owner arrive through Google Play services; restart the app to re-register.</string>
    <string name="health_session_why">Check your connection so PayVoice can sign you in securely.</string>
    <string name="health_play_services_why">Without Google Play services, alerts from your owner can\'t reach this phone.</string>
    <string name="health_payment_app_why">PayVoice listens to Google Pay, so install it to detect payments on this phone.</string>
    <string name="health_pairing_why">Enter the code from your owner so this phone can announce their payments.</string>

