<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- FCM token fetch + future backend event upload. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Held only for the short window around a local announcement (45s cap). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the reliability screen offer a direct battery-optimization exemption dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- PayVoice's OWN status/service notifications only (API 33+). NOT related
         to reading GPay payment notifications — that is Notification Listener
         access, and GPay is the only notification source. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Package visibility (API 30+): detect the installed payment app for the
         diagnostics/reliability screens without broad QUERY_ALL_PACKAGES.
         UPI apps only — GPay is the only capture source. -->
    <queries>
        <package android:name="com.google.android.apps.nbu.paisa.user" />
    </queries>

    <application
        android:name=".PayVoiceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PayVoice"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PayVoice"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.notification.PayVoiceNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Owner→Employee remote delivery: FCM data messages (sent by the
             Supabase fcm-gateway edge function) → validate → dedup →
             existing AnnouncementSpeaker. No notification-tap dependency;
             runs while the app is closed/backgrounded. -->
        <service
            android:name=".service.messaging.PayVoiceMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Startup perf: WorkManager is initialized on demand via
             Configuration.Provider; drop the eager main-thread initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
